# Variables de compilacion del panel (Vite). Copiar a .env.local para desarrollo
# o a .env.production para el build de despliegue.

# URL del backend. En desarrollo: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Nombre y rol que muestra el panel.
VITE_USER_DISPLAY_NAME=Operador
VITE_USER_ROLE=DevOps Engineer

# Autenticacion con Microsoft Entra ID (opcional). Las tres deben definirse
# juntas; con alguna vacia el panel no pide inicio de sesion.
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_API_SCOPE=
