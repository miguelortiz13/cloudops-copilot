# ===========================================================================
# CloudOps Copilot — configuracion del backend
# ===========================================================================
# Copiar a backend/.env y completar. Nunca versionar el .env real.
# Referencia completa: docs/configuration.md

# ---------------------------------------------------------------------------
# Organizacion
# ---------------------------------------------------------------------------
APP_NAME=CloudOps Copilot
# Nombre con el que se presentan los agentes en el chat.
ORG_NAME=Acme Corp
# Tags obligatorias (separadas por comas). Ver docs/governance/tagging-policy.md
MANDATORY_TAGS=Customer,Tenant,Platform,Product,Suite,Environment
# Dimensiones de showback/chargeback de FinOps.
SHOWBACK_TAGS=Customer,Product,Suite,Environment
# URL publica del panel (enlaces en tarjetas de Teams y CORS por defecto).
FRONTEND_URL=http://localhost:5173
# Directorio persistente: cache de costos, historico de KPIs, Excel y snapshots.
# En Azure apunta al File Share montado. Vacio = backend/data
DATA_DIR=
DEFAULT_LOCATION=eastus2

# ---------------------------------------------------------------------------
# Motor cognitivo
# ---------------------------------------------------------------------------
# Sin esta clave el agente responde en modo local basado en reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Service Principal de Azure (rol Reader)
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Credenciales alternas con alcance de lectura sobre todo el tenant. Si estan
# definidas tienen prioridad sobre AZURE_CLIENT_ID / AZURE_CLIENT_SECRET.
AZURE_READER_CLIENT_ID=
AZURE_READER_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Autenticacion del API (Microsoft Entra ID)
# ---------------------------------------------------------------------------
# Con AUTH_ENABLED=false el API responde sin credenciales a cualquiera que
# alcance la URL. Ponerlo en true exige un bearer token de Entra ID en todas las
# rutas salvo /, /api/inventory/health y /api/teams/webhook.
AUTH_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_API_CLIENT_ID=

# Origenes permitidos por CORS, separados por comas. Si se deja vacio se usan
# FRONTEND_URL y los puertos de desarrollo local.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Costos reales (Azure Cost Management)
# ---------------------------------------------------------------------------
# El reporte de FinOps usa facturacion real. Verificado contra Azure: el rol
# Reader basta para consultas de costo con alcance de suscripcion. Donde no haya
# acceso, esos recursos se marcan como estimados y el reporte declara sobre
# cuantas suscripciones alcanza la factura real.
# El rol se asigna por suscripcion. Donde no exista, esos recursos se marcan
# como estimados y el reporte declara la cobertura en cost_data.coverage.
COST_CACHE_TTL_SECONDS=21600
COST_WINDOW_DAYS=30
COST_MAX_CONCURRENT=2
COST_DENIAL_TTL_SECONDS=3600
COST_SUB_WORKERS=8

# Precarga en segundo plano. Cost Management responde 429 con facilidad, asi que
# la precarga va de una suscripcion en una con esta pausa entre ellas: nadie
# espera este trabajo, y con pausas cortas (2.5s) un tercio de las suscripciones
# se quedaba sin dato en cada ciclo. Las que fallen se reintentan al terminar la
# pasada, al doble de lento, en vez de esperar seis horas al siguiente ciclo.
COST_WARM_ENABLED=true
COST_WARM_INTERVAL_SECONDS=21600
COST_WARM_PACE_SECONDS=9
COST_WARM_RETRY=true
COST_WARM_RETRY_BACKOFF=60

# La cache de costos se guarda en DATA_DIR (File Share en Azure),
# de modo que un reinicio arranca con el gasto ya consolidado en vez de volver a
# gastar las ~56 llamadas de la precarga. Sin esto, varios despliegues seguidos
# agotan la cuota de Cost Management.
COST_CACHE_PERSIST=true
COST_CACHE_MAX_AGE_SECONDS=604800

# ---------------------------------------------------------------------------
# Estados de Terraform (cobertura real de IaC)
# ---------------------------------------------------------------------------
# La plataforma lee los estados para saber que recursos gestiona Terraform de
# verdad, en vez de deducirlo de las tags. Requiere lectura de blobs sobre la
# cuenta del estado. SOLO LEE: de cada estado extrae el id y el tipo, y descarta
# el resto sin registrarlo, porque ahi viajan llaves y cadenas de conexion.
TFSTATE_ENABLED=true
# Vacio = cobertura real de IaC desactivada.
TFSTATE_ACCOUNT=
TFSTATE_CONTAINER=tfstate
TFSTATE_CACHE_TTL_SECONDS=21600
# Prefijos de blob a ignorar, separados por comas (vacio = contar todos).
TFSTATE_EXCLUDE_PREFIXES=
# Prefijo de la llave del estado en el HCL que genera el modulo IaC.
IAC_STATE_KEY_PREFIX=platform/azure

# ---------------------------------------------------------------------------
# Inventario y servidor
# ---------------------------------------------------------------------------
INVENTORY_CACHE_TTL_SECONDS=300
# Limita el inventario a estas suscripciones (ids separados por comas). Vacio = todas.
AZURE_ALLOWED_SUBSCRIPTIONS=
PORT=8000
HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────
# Agente Kubernetes SRE (services/k8s_service.py)
# ─────────────────────────────────────────────────────────────
# Conexion por AKS Run Command (unico modo soportado). Con las tres vacias el
# agente queda en modo offline. Ver docs/modules/kubernetes-sre.md
K8S_CLUSTER_NAME=
K8S_RESOURCE_GROUP=
K8S_SUBSCRIPTION_ID=

# --- Webhook de Microsoft Teams ---------------------------------------------
# /api/teams/webhook no puede exigir un token de usuario porque quien lo invoca
# es el servicio de Bot Framework. Con BOT_AUTH_ENABLED=true (valor por defecto)
# se valida el JWT que Bot Framework firma en cada peticion: firma contra las
# llaves publicas del emisor, audiencia igual a MICROSOFT_APP_ID y expiracion.
# Sin esa validacion el endpoint entrega el inventario de la organizacion a
# cualquiera que conozca la URL.
#
# MICROSOFT_APP_ID es el App Id del registro del bot; si se omite se usa
# AZURE_CLIENT_ID.
BOT_AUTH_ENABLED=true
MICROSOFT_APP_ID=
# Webhook entrante de Teams opcional para el reporte semanal del pipeline.
TEAMS_WEBHOOK_URL=
