# Copiar a terraform.tfvars (ignorado por git) y completar.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus2"
name_prefix     = "cloudops"
environment     = "dev"

# Suscripciones que la plataforma observa (recibe Reader en cada una).
observed_subscription_ids = [
  "00000000-0000-0000-0000-000000000000",
]

# Grupos de administración observados (recomendado): Reader heredado por todas
# sus suscripciones, también las futuras.
# observed_management_group_ids = ["mg-organizacion"]

# Cuentas con estados de Terraform (opcional): cobertura real de IaC.
tfstate_sources = [
  # { storage_account_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<cuenta>", container = "tfstate" },
]

org_name       = "Tu nombre u organización"
mandatory_tags = ["Environment", "Project", "ManagedBy"]
showback_tags  = ["Project", "Environment"]

# Motor cognitivo (opcional). Mejor como variable de entorno: TF_VAR_gemini_api_key
# gemini_api_key = ""

# Avisos del job a Discord, Slack o Teams (Workflows) (opcional). Es una credencial:
# mejor como variable de entorno, TF_VAR_notify_webhook_url
# notify_webhook_url = ""

# Miembros de cada grupo de seguridad de la plataforma (Admin, Operator,
# Reader). Vacío = quien aplica Terraform, en Admin.
# Ver docs/security.md#autorización-por-rol.
# role_members = {
#   Admin    = ["00000000-0000-0000-0000-000000000000"]
#   Operator = []
#   Reader   = []
# }

# AWS (opcional, fase 2): cuenta que observa la plataforma. La identidad
# administrada entra por federación OIDC, sin llaves (aws.tf). El apply necesita
# una sesión de AWS: AWS_PROFILE=<perfil SSO> terraform apply.
# aws_account_id = "000000000000"
# aws_region     = "us-east-1"
